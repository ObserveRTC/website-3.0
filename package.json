{
  "name": "observertc-new",
  "version": "0.0.0",
  "description": "Doks theme",
  "author": "Thulite",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "create": "hugo new",
    "dev": "hugo server --disableFastRender --noHTTPCache --renderToMemory",
    "format": "prettier **/** -w -c",
    "build": "hugo --minify --gc --cleanDestinationDir",
    "preview": "vite preview --outDir public",
    "check": "python3 scripts/check-site.py && node scripts/check-services.mjs && node scripts/check-tabs.mjs"
  },
  "dependencies": {
    "@tabler/icons": "^3.12.0",
    "@thulite/doks-core": "^1.8.0",
    "@thulite/images": "^3.3.0",
    "@thulite/inline-svg": "^1.1.0",
    "@thulite/seo": "^2.4.1",
    "thulite": "^2.5.0"
  },
  "devDependencies": {
    "@fullhuman/postcss-purgecss": "^6.0.0",
    "autoprefixer": "^10.4.21",
    "prettier": "^3.3.3",
    "purgecss-whitelister": "^2.4.0",
    "typescript": "5.9.3",
    "vite": "^5.4.2"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
